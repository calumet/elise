{
  "name": "elise",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma frontend de Calumet: design system (Radix + Tailwind) y utilidades de frontend.",
  "scripts": {
    "dev": "pnpm --filter @calumet/elise-ui dev",
    "build:libs": "pnpm -r --filter \"@calumet/elise-*\" build",
    "dev:showcase": "pnpm build:libs && pnpm -r --parallel --filter \"@calumet/elise-icons\" --filter \"@calumet/elise-ui\" --filter \"@calumet/elise-forms\" --filter \"@calumet/elise-tables\" --filter \"@calumet/elise-toasts\" --filter \"@calumet/elise-alerts\" --filter \"@calumet/elise-i18n\" --filter \"showcase\" dev",
    "dev:site": "pnpm build:libs && pnpm -r --parallel --filter \"@calumet/elise-icons\" --filter \"@calumet/elise-ui\" --filter \"@calumet/elise-i18n\" --filter \"site\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:visual": "node scripts/audit-visual.mjs -- --tema=ambos",
    "clean": "pnpm -r clean",
    "publish:packages": "pnpm --filter \"@calumet/elise-*\" publish --no-git-checks",
    "check:versiones": "node scripts/verificar-versiones.mjs",
    "jsr:check": "node scripts/verificar-versiones.mjs && jsr publish --dry-run --allow-dirty"
  },
  "devDependencies": {
    "@calumet/elise-linter": "workspace:*",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "jsr": "^0.14.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0"
}
