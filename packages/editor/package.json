{
  "name": "@calumet/elise-editor",
  "version": "0.1.0",
  "private": false,
  "description": "Editor de texto enriquecido y de bloques para Elise, sobre Plate.",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumet/elise.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.cjs"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "files": [
    "dist",
    "src/tailwind.css"
  ],
  "scripts": {
    "build": "tsdown --dts && pnpm build:jsr",
    "build:jsr": "tsc -p tsconfig.jsr.json && node ../../scripts/prepare-jsr.mjs jsr",
    "dev": "tsdown --watch --dts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist jsr"
  },
  "dependencies": {
    "@calumet/elise-icons": "workspace:^",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list": "53.3.13",
    "@platejs/media": "53.1.4",
    "@platejs/table": "53.0.9",
    "platejs": "53.3.18"
  },
  "devDependencies": {
    "@calumet/elise-ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@calumet/elise-i18n": ">=0.4.0 <1.0.0",
    "@calumet/elise-ui": ">=0.39.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@calumet/elise-i18n": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
