{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node -e \"import('@calumet/suamox/ssg').then((m) => m.runSsg()).catch((err) => { console.error(err); process.exit(1); })\" && node -e \"require('fs').rmSync('dist/client/index.html', { force: true })\"",
    "preview": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@calumet/elise-alerts": "workspace:*",
    "@calumet/elise-i18n": "workspace:*",
    "@calumet/elise-icons": "workspace:*",
    "@calumet/elise-tables": "workspace:*",
    "@calumet/elise-toasts": "workspace:*",
    "@calumet/elise-ui": "workspace:*",
    "@calumet/suamox": "^0.2.10",
    "@calumet/suamox-head": "^0.1.1",
    "@calumet/suamox-hono-adapter": "^0.4.0",
    "@calumet/suamox-router": "^0.2.8",
    "@calumet/suamox-vite-plugin-pages": "^0.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.31",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
