{
  "name": "@calumet/elise-tables",
  "version": "0.7.5",
  "private": false,
  "description": "DataTable (TanStack React Table) y utilidades de filtrado/exportación para Elise.",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumet/elise.git",
    "directory": "packages/tables"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "files": [
    "dist",
    "src/tailwind.css"
  ],
  "scripts": {
    "build": "tsdown --dts && pnpm build:jsr",
    "build:jsr": "tsc -p tsconfig.jsr.json && node ../../scripts/prepare-jsr.mjs jsr",
    "dev": "tsdown --watch --dts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist jsr"
  },
  "dependencies": {
    "@calumet/elise-icons": "workspace:^",
    "@calumet/elise-ui": "workspace:^",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@calumet/elise-ui": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
