{
  "name": "@calumet/elise-themes",
  "version": "0.1.0",
  "private": false,
  "description": "Los tokens de tema de Elise como objeto, para aplicarlos en el DOM o serializarlos en el servidor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumet/elise.git",
    "directory": "packages/themes"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "files": [
    "dist",
    "src/tailwind.css"
  ],
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs && oxfmt src/tokens.generated.ts",
    "build": "pnpm generate && tsdown --dts && pnpm build:jsr && pnpm check",
    "check": "node scripts/check.mjs",
    "build:jsr": "tsc -p tsconfig.jsr.json && node ../../scripts/prepare-jsr.mjs jsr",
    "dev": "tsdown --watch --dts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist jsr"
  },
  "dependencies": {
    "@calumet/elise-ui": "workspace:^"
  },
  "devDependencies": {
    "@calumet/elise-ui": "workspace:^",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@calumet/elise-ui": "workspace:^",
    "react": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
