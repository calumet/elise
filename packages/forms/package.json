{
  "name": "@calumet/elise-forms",
  "version": "0.3.3",
  "private": false,
  "description": "useZodForm y FormField: integración de react-hook-form + Zod para Elise.",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumet/elise.git",
    "directory": "packages/forms"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --dts && pnpm build:jsr",
    "build:jsr": "tsc -p tsconfig.jsr.json && node ../../scripts/prepare-jsr.mjs jsr",
    "dev": "tsdown --watch --dts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist jsr"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1"
  },
  "devDependencies": {
    "@calumet/elise-ui": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@calumet/elise-ui": ">=0.39.0 <1.0.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "typescript": ">=5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
