{
  "name": "@calumet/elise-i18n",
  "version": "0.3.1",
  "private": false,
  "description": "Internacionalización (provider + hooks) y formateo localizado (Intl) para Elise.",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumet/elise.git",
    "directory": "packages/i18n"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "import": "./dist/dates/index.mjs",
      "require": "./dist/dates/index.cjs"
    },
    "./numbers": {
      "types": "./dist/numbers/index.d.ts",
      "import": "./dist/numbers/index.mjs",
      "require": "./dist/numbers/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --dts && pnpm build:jsr",
    "build:jsr": "tsc -p tsconfig.jsr.json && node ../../scripts/prepare-jsr.mjs jsr",
    "dev": "tsdown --watch --dts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist jsr"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
